    border:1px solid #174a70;
    border-radius:8px;
    background:linear-gradient(145deg,#082a49,#03182d);
}

.chart-box{
    height:240px;
}

.panel-title{
    font-size:12px;
    margin-bottom:8px;
}

canvas{
    width:100%!important;
    height:195px!important;
}

.bottom{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:10px;
}

.bottom .panel{
    min-height:205px;
}

.title{
    font-size:12px;
    padding-bottom:9px;
    border-bottom:1px solid #31557344;
    margin-bottom:7px;
}

.sensor{
    height:38px;
    padding:0 9px;
    margin-bottom:6px;
    border-radius:6px;
    background:#092f4d;
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:10px;
}

.sensor-status{
    color:#20ef79;
    font-weight:bold;
}

.info,
.live{
    height:34px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid #31557333;
    font-size:10px;
}

.info span,
.live span{
    color:#bdd3e4;
}

.info b,
.live b{
    color:white;
}

.footer{
    margin-top:10px;
    padding:16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border:1px solid #20d87844;
    border-radius:8px;
    background:linear-gradient(135deg,#063d3b,#06372c);
}

.footer strong{
    font-size:20px;
}

.footer span{
    font-size:10px;
