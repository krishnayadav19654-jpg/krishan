<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AirSense - Smart Air Quality</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    min-height:100vh;
    color:#eef8ff;
    background:
        radial-gradient(circle at 20% 10%,#073b70,transparent 30%),
        linear-gradient(135deg,#021326,#052440,#021426);
}

.header{
    height:68px;
    padding:10px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:linear-gradient(90deg,#073c78,#075184,#06345e);
    border-bottom:1px solid #2171a3;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-icon{
    font-size:35px;
}

.logo h1{
    font-size:25px;
}

.logo h1 span{
    color:#22ef7a;
}

.logo p{
    font-size:10px;
    color:#a9c5db;
}

.top-right{
    display:flex;
    align-items:center;
    gap:20px;
    font-size:11px;
}

.status-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    display:inline-block;
    background:#ff4040;
    margin-right:5px;
}

.status-dot.online{
    background:#20ef79;
    box-shadow:0 0 10px #20ef79;
}

.connect-btn{
    border:0;
    padding:9px 16px;
    border-radius:6px;
    background:#19d875;
    color:#031a12;
    font-weight:bold;
    cursor:pointer;
}

.connect-btn:hover{
    background:#35ef8a;
}

.container{
    width:min(1200px,calc(100% - 25px));
    margin:15px auto 30px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.card{
    min-height:110px;
    padding:14px;
    display:flex;
    align-items:center;
    gap:12px;
    border:1px solid #174a70;
    border-radius:8px;
    background:linear-gradient(145deg,#092f50,#041d35);
}

.icon{
    width:50px;
    height:50px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    font-weight:bold;
