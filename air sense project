}

.hum .icon{
    background:linear-gradient(135deg,#35a8ff,#0767c5);
}

.label{
    color:#bdd2e4;
    font-size:11px;
}

.value{
    font-size:26px;
    font-weight:bold;
    margin-top:4px;
}

.unit{
