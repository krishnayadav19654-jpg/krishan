    .header{
        height:auto;
        gap:10px;
        padding:12px;
        align-items:flex-start;
    }

    .top-right{
        flex-direction:column;
        gap:7px;
    }

    .cards{
        grid-template-columns:1fr;
    }

    .aqi-card{
        grid-column:auto;
    }

    .container{
        width:calc(100% - 14px);
    }

    .footer{
        flex-direction:column;
        gap:8px;
    }
}
</style>
</head>

