<script>

/* =====================================================
   AIRSENSE JAVASCRIPT
   ===================================================== */

let port = null;
let reader = null;
let buffer = "";

const MAX_POINTS = 30;

const pmValues = [];
const co2Values = [];
const tempValues = [];
const humidityValues = [];


/* =====================================================
   CANVAS
   ===================================================== */

function setupCanvas(id){
    const canvas = document.getElementById(id);
    const ctx = canvas.getContext("2d");

    function resize(){
        const ratio = window.devicePixelRatio || 1;

        canvas.width =
            canvas.clientWidth * ratio;

        canvas.height =
            canvas.clientHeight * ratio;

        ctx.scale(ratio,ratio);
    }

    resize();

    window.addEventListener("resize",resize);

    return ctx;
}

const pmCtx = setupCanvas("pmCanvas");
const co2Ctx = setupCanvas("co2Canvas");
const envCtx = setupCanvas("envCanvas");


/* =====================================================
   DRAW GRAPH
   ===================================================== */

function drawGraph(
    ctx,
    values,
    color,
    maxValue
){

    const canvas = ctx.canvas;

    const w = canvas.clientWidth;
    const h = canvas.clientHeight;

    ctx.clearRect(0,0,w,h);

    /* GRID */

    ctx.strokeStyle = "rgba(255,255,255,.07)";
    ctx.lineWidth = 1;

    for(let i=1;i<5;i++){

        const y =
            (h/5)*i;

        ctx.beginPath();

        ctx.moveTo(0,y);

        ctx.lineTo(w,y);

        ctx.stroke();
    }

    if(values.length < 2){
        return;
    }

    /* LINE */

    ctx.beginPath();

    values.forEach((value,index)=>{

        const x =
            index *
            (w/(MAX_POINTS-1));

        const y =
            h -
            (value/maxValue)*h;

        if(index === 0){
            ctx.moveTo(x,y);
        }else{
            ctx.lineTo(x,y);
        }

    });

    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.stroke();

    /* DOTS */

    values.forEach((value,index)=>{

        const x =
            index *
            (w/(MAX_POINTS-1));

        const y =
            h -
            (value/maxValue)*h;

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            2.5,
            0,
            Math.PI*2
        );

        ctx.fillStyle = color;

        ctx.fill();

    });

}


/* =====================================================
   ENVIRONMENT GRAPH
   ===================================================== */

function drawEnvironment(){

    const canvas =
        envCtx.canvas;

    const w =
        canvas.clientWidth;

    const h =
        canvas.clientHeight;

    envCtx.clearRect(
        0,
        0,
        w,
        h
    );

    envCtx.strokeStyle =
        "rgba(255,255,255,.07)";

    for(let i=1;i<5;i++){

        const y =
            h/5*i;

        envCtx.beginPath();

        envCtx.moveTo(0,y);

        envCtx.lineTo(w,y);

        envCtx.stroke();

    }

    if(tempValues.length < 2){
        return;
    }

    drawLine(
        envCtx,
        tempValues,
        "#ff8b20",
        50
    );

    drawLine(
        envCtx,
        humidityValues,
        "#1595ff",
        100
    );

}


function drawLine(
    ctx,
    values,
    color,
    maxValue
){

    const w =
        ctx.canvas.clientWidth;

    const h =
        ctx.canvas.clientHeight;

    ctx.beginPath();

    values.forEach(
        (value,index)=>{

            const x =
                index *
                (w/(MAX_POINTS-1));

            const y =
                h -
                (value/maxValue)*h;

            if(index===0){
                ctx.moveTo(x,y);
            }else{
                ctx.lineTo(x,y);
            }

        }
    );

    ctx.strokeStyle =
        color;

    ctx.lineWidth = 2;

    ctx.stroke();

}


/* =====================================================
   UPDATE GRAPH DATA
   ===================================================== */

function updateGraphs(
    pm,
    co2,
    temp,
    humidity
){

    pmValues.push(pm);
    co2Values.push(co2);
    tempValues.push(temp);
    humidityValues.push(humidity);

    if(pmValues.length > MAX_POINTS){

        pmValues.shift();
        co2Values.shift();
        tempValues.shift();
        humidityValues.shift();

    }

    drawGraph(
        pmCtx,
        pmValues,
        "#9b42ff",
        100
    );

    drawGraph(
        co2Ctx,
        co2Values,
        "#20e879",
        2000
    );

    drawEnvironment();
}


/* =====================================================
   UPDATE DASHBOARD
   ===================================================== */

function updateDashboard(data){

    const pm =
        Number(data.pm25 || 0);

    const co2 =
        Number(data.co2 || 0);

    const temp =
        Number(data.temperature || 0);

    const humidity =
        Number(data.humidity || 0);

    let aqi =
        Number(data.aqi || 0);


    /* CARDS */

    document.getElementById("pm25")
        .textContent =
        pm.toFixed(0);

    document.getElementById("co2")
        .textContent =
        co2.toFixed(0);

    document.getElementById("temperature")
        .textContent =
        temp.toFixed(1);

    document.getElementById("humidity")
        .textContent =
        humidity.toFixed(0);

    document.getElementById("aqi")
        .textContent =
        aqi.toFixed(0);


    /* LIVE */

    document.getElementById("livePM")
        .textContent =
        pm.toFixed(0);

    document.getElementById("liveCO2")
        .textContent =
        co2.toFixed(0);

    document.getElementById("liveTemp")
        .textContent =
        temp.toFixed(1);

    document.getElementById("liveHumidity")
        .textContent =
        humidity.toFixed(0);

    document.getElementById("liveAQI")
        .textContent =
        aqi.toFixed(0);


    /* PM STATUS */

    const pmStatus =
        document.getElementById(
            "pmStatus"
        );

    if(pm <= 35){

        pmStatus.textContent =
            "Good";

        pmStatus.className =
            "good";

    }else if(pm <= 55){

        pmStatus.textContent =
            "Moderate";

        pmStatus.className =
            "good warning";

    }else{

        pmStatus.textContent =
            "High";

        pmStatus.className =
            "good danger";

    }


    /* CO2 STATUS */

    const co2Status =
        document.getElementById(
            "co2Status"
        );

    if(co2 <= 1000){

        co2Status.textContent =
            "Normal";

        co2Status.className =
            "good";

    }else if(co2 <= 1500){

        co2Status.textContent =
            "Elevated";

        co2Status.className =
            "good warning";

    }else{

        co2Status.textContent =
            "High";

        co2Status.className =
            "good danger";

    }


    /* AQI */

    let quality;

    let qualityColor;

    if(aqi <= 50){

        quality = "Good";
        qualityColor = "#20ef79";

    }else if(aqi <= 100){

        quality = "Moderate";
        qualityColor = "#ffc107";

    }else if(aqi <= 150){

        quality = "Unhealthy";
        qualityColor = "#ff8b20";

    }else{

        quality = "Poor";
        qualityColor = "#ff4040";

    }


    const qualityEl =
        document.getElementById(
            "aqiQuality"
        );

    qualityEl.textContent =
        quality;

    qualityEl.style.color =
        qualityColor;


    /* AQI RING */

    const circumference = 251;

    const percent =
        Math.min(aqi,200)/200;

    document.getElementById(
        "aqiRing"
    ).style.stroke =
        qualityColor;

    document.getElementById(
        "aqiRing"
    ).style.strokeDashoffset =
        circumference -
        circumference*percent;


    /* SENSOR STATUS */

    setSensor(
        "pmsSensor",
        data.pms !== false
    );

    setSensor(
        "mhzSensor",
        data.mhz !== false
    );

    setSensor(
        "bmeSensor",
        data.bme !== false
    );

    setSensor(
        "espSensor",
        true
    );


    updateGraphs(
        pm,
        co2,
        temp,
        humidity
    );


    document.getElementById(
        "lastUpdate"
    ).textContent =
        new Date().toLocaleTimeString();

}


/* =====================================================
   SENSOR STATUS
   ===================================================== */

function setSensor(
    id,
    online
){

    const el =
        document.getElementById(id);

    if(online){

        el.textContent =
            "● Working";

        el.style.color =
            "#20ef79";

    }else{

        el.textContent =
            "● Offline";

        el.style.color =
            "#ff4040";

    }

}


/* =====================================================
   ESP32 CONNECT
   ===================================================== */

async function connectESP32(){

    if(!("serial" in navigator)){

        alert(
            "Web Serial supported nahi hai. Chrome ya Edge use karein."
        );

        return;
    }

    try{

        port =
            await navigator.serial.requestPort();

        await port.open({
            baudRate:115200
        });


        document.getElementById(
            "dot"
        ).classList.add("online");

        document.getElementById(
            "connection"
        ).textContent =
            "Device Online";

        document.getElementById(
            "deviceStatus"
        ).textContent =
            "Connected";


        startReading();


    }catch(error){

        console.error(error);

        alert(
            "ESP32 connect nahi hua."
        );

    }

}


/* =====================================================
   SERIAL READER
   ===================================================== */

async function startReading(){

    const decoder =
        new TextDecoder();

    reader =
        port.readable.getReader();

    try{

        while(true){

            const {
                value,
                done
            } =
                await reader.read();

            if(done){
                break;
            }

            buffer +=
                decoder.decode(value);

            let lines =
                buffer.split("\n");

            buffer =
                lines.pop();

            for(
                const line of lines
            ){

                parseSerialData(
                    line.trim()
                );

            }

        }

    }catch(error){

        console.error(error);

    }finally{

        reader.releaseLock();

    }

}


/* =====================================================
   PARSE ESP32 JSON
   ===================================================== */

function parseSerialData(line){

    if(!line){
        return;
    }

    console.log(
        "ESP32:",
        line
    );

    try{

        const data =
            JSON.parse(line);

        updateDashboard(data);

    }catch(error){

        console.log(
            "JSON nahi mila:",
            line
        );

    }

}


/* =====================================================
   CLOCK
   ===================================================== */

function updateClock(){

    document.getElementById(
        "clock"
    ).textContent =
        new Date()
        .toLocaleTimeString();

}

setInterval(
    updateClock,
    1000
);

updateClock();


